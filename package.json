{
  "name": "determask-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Deterministic, auditable PII masking for free text in any language — logs, LLM prompts, MT, support tickets, clinical notes. Monorepo root.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "lint:redos": "node scripts/redos-lint.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm test && pnpm smoke && pnpm lint:redos",
    "test:watch": "vitest",
    "claims": "vitest run packages/core/test/claims.test.ts --reporter=verbose",
    "smoke": "node scripts/smoke.mjs",
    "verify:pack": "node scripts/verify-pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
