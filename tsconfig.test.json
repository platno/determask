{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "paths": {
      "@determask/core": ["./packages/core/src/index.ts"],
      "@determask/pack-core": ["./packages/pack-core/src/index.ts"],
      "@determask/pack-vi": ["./packages/pack-vi/src/index.ts"],
      "@determask/pack-sr": ["./packages/pack-sr/src/index.ts"],
      "@determask/pack-sg": ["./packages/pack-sg/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "packages/*/src/**/*.ts", "examples/**/*.ts", "vitest.config.ts"]
}
