{
  "name": "@determask/pack-sr",
  "version": "0.1.0-alpha.0",
  "description": "Serbian locale pack for determask: JMBG, PIB tax number, bank account (MOD 97), LBO health insurance number, phones.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platno/determask.git",
    "directory": "packages/pack-sr"
  },
  "homepage": "https://github.com/platno/determask/tree/main/packages/pack-sr#readme",
  "bugs": {
    "url": "https://github.com/platno/determask/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/pack-sr/"
  },
  "dependencies": {
    "@determask/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "pii",
    "masking",
    "redaction",
    "serbia",
    "serbian",
    "jmbg",
    "determask"
  ]
}
