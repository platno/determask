{
  "name": "@determask/pack-core",
  "version": "0.0.1",
  "description": "Locale-independent recognizers for determask: email, URL, IP, payment card, IBAN.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platno/determask.git",
    "directory": "packages/pack-core"
  },
  "homepage": "https://github.com/platno/determask/tree/main/packages/pack-core#readme",
