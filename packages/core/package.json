{
  "name": "@determask/core",
  "version": "0.0.1",
  "description": "Deterministic PII masking engine: types, normalizer, analyze/anonymize/restore, fail-closed operators.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platno/determask.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/platno/determask/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/platno/determask/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pii",
    "phi",
    "masking",
    "pseudonymization",
    "redaction",
    "deterministic",
    "privacy",
    "gdpr",
    "hipaa",
    "logs",
    "llm",
    "clinical"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/core/"
  },
  "publishConfig": {
    "access": "public"
  }
}
