{
  "name": "@determask/core",
  "version": "0.1.0-alpha.0",
  "description": "Deterministic, offline PII masking engine: Unicode folding with offset maps, a recognizer toolkit, known values, typed reversible placeholders, strict restore. Fails closed.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platno/determask.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/platno/determask/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/platno/determask/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pii",
    "phi",
    "masking",
    "pseudonymization",
    "redaction",
    "deterministic",
    "privacy",
    "gdpr",
    "hipaa",
    "logs",
    "llm",
    "clinical"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --root ../.. packages/core/"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
